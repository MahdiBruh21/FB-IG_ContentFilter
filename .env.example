# -------------------------------------------------------------------------
# Copiez ce fichier en .env et remplissez les valeurs.
# Aucune clé ni secret n'est jamais commitée (voir .gitignore).
# -------------------------------------------------------------------------

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=social_media
MONGO_COLLECTION_POSTS=posts
MONGO_COLLECTION_COMMENTS=comments

# Meta Graph API (Facebook + Instagram)
META_VERSION=v21.0
# App ID de l'application Meta for Developers (obligatoire depuis la v9 de l'API pour /posts)
META_APP_ID=
# Jeton d'accès (Page Access Token pour Facebook, User/Account Token pour Instagram)
META_ACCESS_TOKEN=
# Identifiants obligatoires selon la plateforme sélectionnée
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# Comportement
SEARCH_LIMIT=200          # nombre maximal de posts à collecter au total
POSTS_PER_PAGE=25         # taille de page de l'API (max 25)
RETRY_MAX_ATTEMPTS=5
RATE_LIMIT_RETRY_SECONDS=60
